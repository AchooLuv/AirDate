# Public canonical URL (used by metadata, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://airdate.vercel.app

# Optional: protects /api/cron/refresh when invoked manually or by Vercel Cron
CRON_SECRET=

# Optional: Upstash Redis for cross-instance caching (free tier is enough)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Reserved for a future TMDB provider. The default installation is keyless
# and uses Douban's public upcoming list.
# TMDB_API_KEY=

# Optional: a contact string included in outbound User-Agent headers.
# SOURCE_CONTACT=https://github.com/AchooLuv/AirDate
